# Copy to .env.local when changing settings. This example contains no credentials.
MEMORY_MODEL_MODE=demo
# live mode requires a real key; demo is a deterministic teaching model.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# local is restricted to loopback. Container entrypoint uses token mode.
MEMORY_AUTH_MODE=local
# token mode: JSON mapping long random tokens to server-owned user IDs.
MEMORY_API_TOKENS=
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
